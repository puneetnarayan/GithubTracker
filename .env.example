# GitHub OAuth App credentials (https://github.com/settings/developers).
# Callback URL should be: <your-deployment-url>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Random 32+ byte secret used to encrypt the NextAuth session JWT.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Optional. When GITHUB_CLIENT_ID is unset, the app automatically runs in
# mock mode (demo data, no GitHub connection required). Set MOCK_MODE=false
# to force a live connection even without full credentials configured yet,
# or MOCK_MODE=true to force demo mode even when credentials are present.
MOCK_MODE=

# Optional. Comma-separated GitHub usernames (case-insensitive) allowed to
# sign in. Leave empty to allow any GitHub account to sign in and use the
# app against their own repositories. Set this to your own username to
# restrict this deployment — including the history-cleanup wizard — to
# yourself only, e.g.:
# ALLOWED_GITHUB_USERNAMES=puneetnarayan
ALLOWED_GITHUB_USERNAMES=
